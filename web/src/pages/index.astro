---
import Layout from '../layouts/Layout.astro';
---
<Layout>
  <section class="hero">
    <h1>Colección Esencial</h1>
    <p>Ropa que respira. Diseño limpio, tejidos naturales, precios justos.</p>
    <a href="#productos" class="btn">Ver colección</a>
  </section>

  <section class="section" id="productos">
    <h2 class="section-title">Novedades</h2>
    <p class="section-sub">Lo último en básicos de calidad.</p>

    <div class="product-grid" id="product-grid">
      <!-- Populado dinámicamente desde la API -->
    </div>

    <div id="product-error" style="display:none; text-align:center; padding:32px; color:#999;">
      No se ha podido cargar el catálogo. Inténtalo de nuevo más tarde.
    </div>
  </section>

  <script is:inline>
    (function() {
      const API_BASE = "http://100.106.8.87:8000";
      const grid = document.getElementById("product-grid");
      const errorEl = document.getElementById("product-error");

      // Colores de fondo por defecto para las imágenes placeholder
      const COLORS = ["#e8ddd4", "#4a4a4a", "#3a5a8c", "#2a2a2a", "#c4a574", "#f5efe6", "#8b7355", "#3d5a40"];

      function stockBadge(stock) {
        if (stock === 0) return '<span class="stock-badge out">Agotado</span>';
        if (stock <= 3) return `<span class="stock-badge low">Quedan ${stock}</span>`;
        return '<span class="stock-badge in">En stock</span>';
      }

      function parseSizes(tallas) {
        if (!tallas) return [];
        // Viene como string "S,M,L" o JSON array
        if (typeof tallas === "string") {
          try { const p = JSON.parse(tallas); if (Array.isArray(p)) return p; } catch(_) {}
          return tallas.split(",").map(s => s.trim());
        }
        if (Array.isArray(tallas)) return tallas;
        return [];
      }

      function renderProduct(p, i) {
        const color = COLORS[i % COLORS.length];
        const sizes = parseSizes(p.tallas);
        return `
          <div class="product-card">
            <div class="product-img" style="background: ${color}; display: flex; align-items: center; justify-content: center; font-size: 48px; opacity: 0.7;">
              👕
            </div>
            <div class="product-info">
              <div class="product-name">${escapeHtml(p.nombre)}</div>
              <div class="product-category">${escapeHtml(p.categoria)}</div>
              <div class="product-price">${p.precio.toFixed(2)} €</div>
              <div class="product-stock">${stockBadge(p.stock)}</div>
              ${sizes.length ? '<div class="product-sizes">' + sizes.map(s => `<span class="size-tag">${escapeHtml(s)}</span>`).join("") + '</div>' : ''}
            </div>
          </div>`;
      }

      function escapeHtml(text) {
        const div = document.createElement("div");
        div.textContent = text;
        return div.innerHTML;
      }

      async function loadProducts() {
        // Skeleton loading
        grid.innerHTML = Array(4).fill('<div class="product-card skeleton"></div>').join("");

        try {
          const res = await fetch(`${API_BASE}/products`);
          if (!res.ok) throw new Error("API error");
          const products = await res.json();

          if (!products.length) {
            grid.innerHTML = '<p style="grid-column:1/-1;text-align:center;color:#999;padding:32px;">No hay productos disponibles.</p>';
            return;
          }

          grid.innerHTML = products.map(renderProduct).join("");
        } catch (err) {
          grid.innerHTML = "";
          errorEl.style.display = "block";
        }
      }

      loadProducts();
    })();
  </script>
</Layout>
