<style is:global>
  /* ── Widget flotante ThreadBot ── */
  #threadbot-root { font-family: 'Inter', system-ui, sans-serif; }

  .tb-bubble {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 9999;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #1a1a1a;
    border: 2px solid #d4a853;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 20px rgba(0,0,0,0.3);
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .tb-bubble:hover {
    transform: scale(1.08);
    box-shadow: 0 6px 28px rgba(0,0,0,0.4);
  }

  .tb-bubble svg { width: 24px; height: 24px; stroke: #d4a853; fill: none; }

  .tb-bubble.hidden { display: none; }

  /* ── Panel de chat ── */
  .tb-panel {
    position: fixed;
    bottom: 92px;
    right: 24px;
    z-index: 9999;
    width: 380px;
    height: 560px;
    max-height: calc(100dvh - 120px);
    background: #111;
    border: 1px solid #2a2a2a;
    border-radius: 16px;
    display: none;
    flex-direction: column;
    overflow: hidden;
    box-shadow: 0 16px 48px rgba(0,0,0,0.5);
  }

  .tb-panel.open { display: flex; }

  /* Header */
  .tb-header {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    background: #141414;
    border-bottom: 1px solid #222;
    flex-shrink: 0;
  }

  .tb-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #1a1a1a;
    border: 2px solid #d4a853;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 13px;
    color: #d4a853;
    flex-shrink: 0;
  }

  .tb-header-text { flex: 1; min-width: 0; }
  .tb-bot-name { font-size: 15px; font-weight: 600; color: #f0f0f0; }
  .tb-bot-sub { font-size: 11px; color: #888; margin-top: 1px; }

  .tb-status {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #4caf50;
    box-shadow: 0 0 6px rgba(76,175,80,0.6);
    flex-shrink: 0;
  }

  .tb-close {
    background: none;
    border: none;
    color: #666;
    font-size: 18px;
    cursor: pointer;
    padding: 4px 8px;
    line-height: 1;
    transition: color 0.15s;
  }
  .tb-close:hover { color: #fff; }

  /* Messages */
  .tb-messages {
    flex: 1;
    overflow-y: auto;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    scrollbar-width: thin;
    scrollbar-color: #2a2a2a transparent;
  }

  .tb-msg {
    display: flex;
    flex-direction: column;
    max-width: 82%;
    animation: tbFadeUp 0.2s ease;
  }

  @keyframes tbFadeUp {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .tb-msg.bot { align-self: flex-start; }
  .tb-msg.user { align-self: flex-end; }

  .tb-msg-bubble {
    padding: 10px 14px;
    border-radius: 12px;
    font-size: 13px;
    line-height: 1.6;
    word-break: break-word;
  }

  .tb-msg.bot .tb-msg-bubble {
    background: #1a1a1a;
    color: #e0e0e0;
    border-left: 3px solid #d4a853;
  }

  .tb-msg.user .tb-msg-bubble {
    background: #d4a853;
    color: #111;
    font-weight: 500;
  }

  .tb-msg-time {
    font-size: 10px;
    color: #555;
    margin-top: 3px;
    padding: 0 4px;
  }

  .tb-msg.user .tb-msg-time { text-align: right; }

  /* Typing */
  .tb-typing .tb-msg-bubble {
    display: flex;
    gap: 4px;
    padding: 12px 16px;
  }

  .tb-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #d4a853;
    animation: tbBounce 1.2s infinite;
  }
  .tb-dot:nth-child(2) { animation-delay: 0.2s; }
  .tb-dot:nth-child(3) { animation-delay: 0.4s; }

  @keyframes tbBounce {
    0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
    30% { transform: translateY(-5px); opacity: 1; }
  }

  /* Chips */
  .tb-chips {
    display: flex;
    gap: 6px;
    padding: 0 16px 10px;
    flex-wrap: wrap;
    flex-shrink: 0;
  }

  .tb-chip {
    background: transparent;
    border: 1px solid #333;
    color: #d4a853;
    font-family: inherit;
    font-size: 11px;
    padding: 5px 12px;
    border-radius: 20px;
    cursor: pointer;
    transition: all 0.15s;
    white-space: nowrap;
  }

  .tb-chip:hover {
    background: rgba(212,168,83,0.1);
    border-color: #d4a853;
  }

  /* Input */
  .tb-input-area {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px 14px;
    border-top: 1px solid #1e1e1e;
    flex-shrink: 0;
  }

  .tb-input-wrap {
    flex: 1;
    background: #1a1a1a;
    border: 1px solid #2a2a2a;
    border-radius: 24px;
    display: flex;
    align-items: center;
    padding: 0 14px;
    transition: border-color 0.15s;
  }

  .tb-input-wrap:focus-within { border-color: #d4a853; }

  .tb-input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    color: #e0e0e0;
    font-family: inherit;
    font-size: 13px;
    padding: 10px 0;
  }

  .tb-input::placeholder { color: #444; }

  .tb-send {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: #d4a853;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.15s;
    flex-shrink: 0;
  }

  .tb-send:hover:not(:disabled) { background: #c4963a; }
  .tb-send:disabled { background: #222; cursor: not-allowed; }
  .tb-send:disabled svg { opacity: 0.3; }

  /* Footer */
  .tb-footer {
    text-align: center;
    font-size: 10px;
    color: #333;
    padding: 0 0 8px;
    flex-shrink: 0;
  }

  @media (max-width: 420px) {
    .tb-panel { width: calc(100vw - 16px); right: 8px; bottom: 80px; height: 480px; }
  }
</style>

<div id="threadbot-root">
  <!-- Botón flotante -->
  <button class="tb-bubble" id="tb-bubble" aria-label="Abrir chat">
    <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
    </svg>
  </button>

  <!-- Panel de chat -->
  <div class="tb-panel" id="tb-panel">
    <div class="tb-header">
      <div class="tb-avatar">TW</div>
      <div class="tb-header-text">
        <div class="tb-bot-name">ThreadBot</div>
        <div class="tb-bot-sub">Asistente de ThreadWear</div>
      </div>
      <div class="tb-status"></div>
      <button class="tb-close" id="tb-close">&times;</button>
    </div>

    <div class="tb-messages" id="tb-messages"></div>

    <div class="tb-chips" id="tb-chips">
      <button class="tb-chip" data-msg="Ver catálogo">Ver catálogo</button>
      <button class="tb-chip" data-msg="¿Cómo hago un pedido?">Cómo pedir</button>
      <button class="tb-chip" data-msg="¿Cuánto tardan los envíos?">Envíos</button>
    </div>

    <div class="tb-input-area">
      <div class="tb-input-wrap">
        <input class="tb-input" id="tb-input" type="text" placeholder="Escribe tu mensaje..." autocomplete="off" />
      </div>
      <button class="tb-send" id="tb-send" disabled aria-label="Enviar">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#111" stroke-width="2.5" stroke-linecap="round">
          <line x1="22" y1="2" x2="11" y2="13"></line>
          <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
        </svg>
      </button>
    </div>

    <div class="tb-footer">Powered by <span style="color:#555">WinoWin</span></div>
  </div>
</div>

<script is:inline>
  (function() {
    const API_URL = "http://100.106.8.87:8000/chat";
    const STORE_NAME = "ThreadWear";
    const SESSION_ID = (typeof crypto.randomUUID === "function" ? crypto.randomUUID() : Math.random().toString(36).slice(2) + Date.now().toString(36));

    const bubble = document.getElementById("tb-bubble");
    const panel = document.getElementById("tb-panel");
    const closeBtn = document.getElementById("tb-close");
    const messagesEl = document.getElementById("tb-messages");
    const inputEl = document.getElementById("tb-input");
    const sendBtn = document.getElementById("tb-send");
    const chipsEl = document.getElementById("tb-chips");

    let isOpen = false;

    function open() {
      panel.classList.add("open");
      bubble.classList.add("hidden");
      isOpen = true;
      inputEl.focus();
    }

    function close() {
      panel.classList.remove("open");
      bubble.classList.remove("hidden");
      isOpen = false;
    }

    bubble.addEventListener("click", open);
    closeBtn.addEventListener("click", close);

    function timeNow() {
      return new Date().toLocaleTimeString("es-ES", { hour: "2-digit", minute: "2-digit" });
    }

    function scrollBottom() {
      messagesEl.scrollTo({ top: messagesEl.scrollHeight, behavior: "smooth" });
    }

    function renderMarkdown(text) {
      return text
        .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
        .replace(/\*(.*?)\*/g, '<em>$1</em>')
        .replace(/\n/g, '<br>')
        .replace(/\n?\d+\.\s/g, '<br>• ');
    }

    function appendMessage(role, text) {
      const wrap = document.createElement("div");
      wrap.className = `tb-msg ${role}`;

      const bubble = document.createElement("div");
      bubble.className = "tb-msg-bubble";
      bubble.innerHTML = renderMarkdown(text);

      const time = document.createElement("div");
      time.className = "tb-msg-time";
      time.textContent = timeNow();

      wrap.appendChild(bubble);
      wrap.appendChild(time);
      messagesEl.appendChild(wrap);
      scrollBottom();
    }

    function showTyping() {
      const wrap = document.createElement("div");
      wrap.className = "tb-msg bot tb-typing";
      wrap.id = "tb-typing";
      const b = document.createElement("div");
      b.className = "tb-msg-bubble";
      b.innerHTML = '<div class="tb-dot"></div><div class="tb-dot"></div><div class="tb-dot"></div>';
      wrap.appendChild(b);
      messagesEl.appendChild(wrap);
      scrollBottom();
    }

    function removeTyping() {
      const el = document.getElementById("tb-typing");
      if (el) el.remove();
    }

    async function sendMessage(text) {
      const msg = text.trim();
      if (!msg) return;

      inputEl.value = "";
      sendBtn.disabled = true;
      chipsEl.style.display = "none";

      appendMessage("user", msg);
      showTyping();

      try {
        const res = await fetch(API_URL, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ session_id: SESSION_ID, message: msg })
        });

        removeTyping();

        if (!res.ok) {
          appendMessage("bot", "Lo siento, ha habido un problema. ¿Puedes intentarlo de nuevo?");
          return;
        }

        const data = await res.json();
        appendMessage("bot", data.reply);

      } catch {
        removeTyping();
        appendMessage("bot", "No puedo conectar con el asistente ahora mismo. ¿Está el servidor en marcha?");
      }
    }

    inputEl.addEventListener("input", () => {
      sendBtn.disabled = inputEl.value.trim() === "";
    });

    inputEl.addEventListener("keydown", e => {
      if (e.key === "Enter" && inputEl.value.trim()) {
        e.preventDefault();
        sendMessage(inputEl.value);
      }
    });

    sendBtn.addEventListener("click", () => sendMessage(inputEl.value));

    chipsEl.querySelectorAll(".tb-chip").forEach(chip => {
      chip.addEventListener("click", () => sendMessage(chip.dataset.msg));
    });

    // Bienvenida
    appendMessage("bot", `¡Hola! Soy el asistente virtual de **${STORE_NAME}**. ¿En qué puedo ayudarte? Puedes preguntarme por productos, tallas, precios o hacer un pedido.`);
  })();
</script>
