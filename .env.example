# ============================================================
# ThreadBot — Configuración
# ============================================================
# Copia este archivo como .env y rellena con tus propias claves.
# NUNCA subas el .env real al repositorio.
# ============================================================

# ── LLM ────────────────────────────────────────────────────
# Clave de API de Groq (https://console.groq.com/keys)
# Modelo usado: llama-3.3-70b-versatile
GROQ_API_KEY=gsk_tu_clave_aqui

# ── Base de datos ──────────────────────────────────────────
# PostgreSQL en Neon (https://neon.tech)
# Formato: postgresql://usuario:password@host/nombre_bd?sslmode=require
DATABASE_URL=postgresql://usuario:tu_password@tu-host.neon.tech/nombre_bd?sslmode=require

# ── Email ──────────────────────────────────────────────────
# Clave de API de Resend (https://resend.com/api-keys)
RESEND_API_KEY=re_tu_clave_aqui

# ── n8n (automatizaciones) ─────────────────────────────────
# URL de tu instancia de n8n (local o cloud)
N8N_BASE_URL=http://localhost:5678

# ── App ────────────────────────────────────────────────────
# URL base donde corre ThreadBot (desarrollo: localhost)
APP_BASE_URL=http://localhost:8000
